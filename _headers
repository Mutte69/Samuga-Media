# Build 16.2.1 — public HTML must always revalidate so Cloudflare does not
# mix a new page with an old JavaScript/CSS bundle.
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/about
  Cache-Control: no-cache, no-store, must-revalidate
/advertising
  Cache-Control: no-cache, no-store, must-revalidate
/contact
  Cache-Control: no-cache, no-store, must-revalidate
/editorial-policy
  Cache-Control: no-cache, no-store, must-revalidate
/corrections-policy
  Cache-Control: no-cache, no-store, must-revalidate
/privacy-policy
  Cache-Control: no-cache, no-store, must-revalidate
/terms
  Cache-Control: no-cache, no-store, must-revalidate
/article*
  Cache-Control: no-cache, no-store, must-revalidate
/admin*
  Cache-Control: no-cache, no-store, must-revalidate
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Build-numbered assets are immutable. A new build uses a new filename.
/site-build16-2-1.js
  Cache-Control: public, max-age=31536000, immutable
/samuga-v3-shell-16-2-1.js
  Cache-Control: public, max-age=31536000, immutable
/website-settings-runtime-16-2-1.js
  Cache-Control: public, max-age=31536000, immutable
/website-settings-runtime-16-2-1.css
  Cache-Control: public, max-age=31536000, immutable
/admin-website-settings-16-2-0.js
  Cache-Control: public, max-age=31536000, immutable
/admin-website-settings-16-2-0.css
  Cache-Control: public, max-age=31536000, immutable

# Existing shared versioned assets.
/site-v3-16-2-1.css
  Cache-Control: public, max-age=31536000, immutable
/site-common-build16-0-1.js
  Cache-Control: public, max-age=31536000, immutable
/site-build16-2-1.css
  Cache-Control: public, max-age=31536000, immutable
/site-transitions-build15-2.js
  Cache-Control: public, max-age=31536000, immutable
/analytics-build12.js
  Cache-Control: public, max-age=31536000, immutable
/article-build16-0-1.js
  Cache-Control: public, max-age=31536000, immutable
/admin-build15-9.css
  Cache-Control: public, max-age=31536000, immutable
/admin-build15-9.js
  Cache-Control: public, max-age=31536000, immutable

# Settings and live feeds must never be frozen in the edge cache.
/site-social-links.json
  Cache-Control: no-cache, no-store, must-revalidate
/api/site-settings
  Cache-Control: no-store
/api/site-settings/*
  Cache-Control: no-store
/api/newsletter/*
  Cache-Control: no-store
/feed.xml
  Cache-Control: public, max-age=60, s-maxage=120

# Brand assets can be cached for a long time.
/assets/Samuga_Media_Logo_White.png
  Cache-Control: public, max-age=31536000, immutable
/assets/Samuga_Media_Mark_White.png
  Cache-Control: public, max-age=31536000, immutable
/assets/SamugaNewsBot_Profile.png
  Cache-Control: public, max-age=31536000, immutable
/assets/samuga-article-placeholder.png
  Cache-Control: public, max-age=31536000, immutable
