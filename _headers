# Build 16.3.1 — baseline browser hardening. CSP is report-only because the
# legacy static site still contains audited inline scripts that will be migrated
# gradually without risking a production outage.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data: https:; connect-src 'self' https://samuga-news-bot-production.up.railway.app https://api.telegram.org; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:

# Build 16.3.1 — public HTML must always revalidate so Cloudflare does not
# mix a new page with an old JavaScript/CSS bundle.
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/about
  Cache-Control: no-cache, no-store, must-revalidate
/advertising
  Cache-Control: no-cache, no-store, must-revalidate
/contact
  Cache-Control: no-cache, no-store, must-revalidate
/editorial-policy
  Cache-Control: no-cache, no-store, must-revalidate
/corrections-policy
  Cache-Control: no-cache, no-store, must-revalidate
/privacy-policy
  Cache-Control: no-cache, no-store, must-revalidate
/terms
  Cache-Control: no-cache, no-store, must-revalidate
/article*
  Cache-Control: no-cache, no-store, must-revalidate
/admin*
  Cache-Control: no-cache, no-store, must-revalidate
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

